<decorators defaultdir="/WEB-INF/decorators">
    <!-- Bỏ qua Sitemesh cho các trang xác thực (Auth) -->
    <excludes>
        <pattern>/login</pattern>
        <pattern>/register</pattern>
        <pattern>/verify-otp</pattern>
    </excludes>

    <!-- Áp dụng layout Admin -->
    <decorator name="admin" page="admin.jsp">
        <pattern>/admin/*</pattern>
    </decorator>

    <!-- Áp dụng layout User cho toàn bộ các trang còn lại -->
    <decorator name="user" page="user.jsp">
        <pattern>/*</pattern>
    </decorator>
</decorators>